# awork API
AWORK_API_TOKEN=dein-bearer-token
AWORK_BASE_URL=https://api.awork.com/api/v1

# Anthropic API (Claude)
ANTHROPIC_API_KEY=dein-anthropic-api-key
# Optional: Modelle übersteuern (z. B. bei Modell-Retirement, ohne Deploy)
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_MODEL_FAST=claude-haiku-4-5

# Middleware
PORT=3500
API_KEY=ein-sicherer-api-key-fuer-webhook-auth

# Optional: Logging
LOG_LEVEL=info

# Optional: Microsoft Graph – E-Mail-Polling UND Mail-Versand (Automationen)
# Wenn gesetzt, pollt die Middleware automatisch nach E-Mails mit
# der Kategorie "→ awork"; die Zeiterfassungs-Automationen versenden
# über dasselbe Postfach (MS_USER_EMAIL).
# Azure AD App-Registrierung nötig, Application Permissions:
#   Mail.ReadWrite (Polling) + Mail.Send (Automationen), je mit Admin Consent
MS_TENANT_ID=deine-azure-ad-tenant-id
MS_CLIENT_ID=deine-app-client-id
MS_CLIENT_SECRET=dein-app-client-secret
# Postfächer, in denen die Kategorie "→ awork" beobachtet wird (kommagetrennt)
MS_MAILBOXES=jan@straightup-digital.de,gabi@straightup-digital.de
# Alt-Variante für ein einzelnes Postfach (wird von MS_MAILBOXES überschrieben)
# MS_USER_EMAIL=deine@email.de
# Absender der Automations-Mails (Default: erstes Postfach aus MS_MAILBOXES)
MS_SENDER_EMAIL=jan@straightup-digital.de
MS_POLL_INTERVAL=180000
MS_TRIGGER_CATEGORY=→ awork

# Website-Feedback (Chrome-Extension)
# Workspace-URL wie im Browser sichtbar, z. B. https://straightup.awork.com
AWORK_WORKSPACE_URL=https://dein-workspace.awork.com
# Ablageort für Daten: SQLite-DB + Feedback-Keys (Default ./data, im Container /app/data)
DATA_DIR=./data

# Erst-Admin für den Session-Login (wird nur angelegt, solange es keine Nutzer gibt;
# Passwort nach dem ersten Login ändern). Weitere Nutzer über POST /api/users.
ADMIN_EMAIL=jan@straightup-digital.de
ADMIN_NAME=Jan
ADMIN_INITIAL_PASSWORD=bitte-sicheres-passwort-waehlen
